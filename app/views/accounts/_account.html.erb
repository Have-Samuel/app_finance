<div id="<%= dom_id account %>" class="p-4 bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
  <div class="flex justify-between items-center">
    <div>
      <h3 class="text-lg font-semibold text-gray-900"><%= account.name %></h3>
      <p class="text-sm text-gray-500">Account ID: <%= account.id %></p>
    </div>
    <div class="text-right">
      <p class="text-xl font-bold <%= account.balance.to_f < 0 ? 'text-red-600' : 'text-gray-900' %>">
        <%= number_to_currency(account.balance) %>
      </p>
      <%= link_to "View Details", account, class: "text-sm text-indigo-600 hover:text-indigo-900 font-medium" %>
    </div>
  </div>
</div>
